#!/bin/sh
# AppImage entry point: start the bundled executable.
#
# The caller's LD_LIBRARY_PATH is kept in LD_LIBRARY_PATH_ORIG, which the app restores
# (or clears when it was empty) for the system tools it runs (loginctl, xset, gdbus, ...)
# so that nothing the AppImage runtime added leaks into them.
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH_ORIG="${LD_LIBRARY_PATH:-}"
exec "$HERE/usr/bin/eye-tracker" "$@"
